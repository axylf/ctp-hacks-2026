# Copy to .env and fill in:  cp .env.example .env

# Get a key at https://aistudio.google.com/apikey
# Leave blank to run on the offline extractor — everything still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Vite proxies /api to this address while you run npm run dev.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Only needed for the DB seed script and the Flask backend.
# The ML pipeline itself never touches the database.
DATABASE_URL=postgresql://USER@127.0.0.1:5432/syllabus_planner
